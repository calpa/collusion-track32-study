# Copy to compute.env and fill in. compute.env is gitignored — never commit it.
# Used by our_experiment/with_endpoint.sh and our_experiment/smoke_endpoints.py.
# The Modal Shared Endpoint token id/secret pair forms the bearer credential:
#   LLM_API_KEY = "${MODAL_PROXY_TOKEN_ID}.${MODAL_PROXY_TOKEN_SECRET}"
MODAL_PROXY_TOKEN_ID=your_modal_proxy_token_id
MODAL_PROXY_TOKEN_SECRET=your_modal_proxy_token_secret

# Endpoint base URLs and model names per family (as provisioned on Modal)
EP_DEEPSEEK=https://your-endpoint.modal.run/v1
MODEL_DEEPSEEK=deepseek-ai/DeepSeek-V4.1-Flash
EP_QWEN38=https://your-endpoint.modal.run/v1
MODEL_QWEN38=your-qwen-model-name
EP_GLM53=https://your-endpoint.modal.run/v1
MODEL_GLM53=your-glm-model-name
